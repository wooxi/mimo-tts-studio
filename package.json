{
  "name": "mimo-tts-studio",
  "version": "5.0.0",
  "private": true,
  "description": "MiMo TTS Studio — 基于小米 MiMo-V2.5-TTS 系列的语音创作工作台，运行于 Cloudflare Workers + D1 + R2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:mock": "wrangler dev --var MIMO_MOCK:1",
    "harness": "node scripts/local-harness.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:auth": "node scripts/check-failclosed.mjs",
    "check:migration": "node scripts/check-migration.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute mimo-tts-db --local --file=src/db/schema.sql",
    "db:remote": "wrangler d1 execute mimo-tts-db --remote --file=src/db/schema.sql",
    "brand": "node scripts/gen-logos.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
